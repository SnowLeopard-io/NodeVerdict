{
  "name": "node-verdict",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "node-verdict": "./cli/check.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:cli && tsc && vite build",
    "build:cli": "esbuild cli/check.ts --bundle --platform=node --format=esm --outfile=cli/check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "agent": "node server/live-agent.mjs"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  }
}
